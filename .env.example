# Leave the Reddit credentials unset to run against the synthetic demo corpus.
# Fill them in -- after the app is approved under Reddit's Responsible Builder
# Policy -- and the same code path captures live data instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=server:com.example.listener:v0.1.0 (by /u/your_reddit_username)

# The documented free-tier ceiling. Treated as a cold-start fallback only:
# the live X-Ratelimit-* headers override it on the first response.
RATE_LIMIT_QPM=100
RATE_LIMIT_HEADROOM=0.15

DATABASE_URL=sqlite:///social_listener.db

RETENTION_MONTHS=18
COMPLIANCE_SWEEP_HOURS=24
