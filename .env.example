# Leave YOUTUBE_API_KEY unset to run against the synthetic demo corpus.
# Set it -- a self-service key from the Google Cloud console, no approval
# needed -- and the same code path captures live data instead.
#
# Restrict the key to the YouTube Data API. It is a bearer credential with a
# billing consequence: an exposed key lets a stranger spend your daily quota.
YOUTUBE_API_KEY=

DATABASE_URL=sqlite:///social_listener.db

# Share of the 10,000-unit day that discovery (search.list, 100 units a call)
# may consume. Everything else is 1-unit calls.
DISCOVERY_BUDGET_FRACTION=0.20

# Units held back so the retention job can always run. Refreshing stored data
# is a policy obligation; capturing more of it is not.
RETENTION_RESERVE_UNITS=500

# Pages of comments per video per harvest. Each page is 1 unit and up to 100
# comments.
COMMENT_PAGES_PER_VIDEO=3
